# Copy this file to .env and fill in real values. Never commit .env to version control.

# MongoDB connection string (local or MongoDB Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/banking_management_system

# Secret used to sign JSON Web Tokens - use a long random string in production
JWT_SECRET=replace_this_with_a_long_random_secret

# Port the API server listens on
PORT=5000

# Comma separated list of origins allowed to call this API (your frontend URL)
CLIENT_ORIGIN=http://127.0.0.1:5500

# Bootstrap admin account, created automatically on first server start if it
# does not already exist. Change the password before deploying anywhere real.
ADMIN_EMAIL=admin@bank.local
ADMIN_PASSWORD=Admin@12345
